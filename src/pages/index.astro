---
// index.astro — the home page. Files in src/pages become URLs
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<BaseLayout title="My Notebook">
  <h1>Out Blog Spot</h1>
  <p class="intro">My first blog that I threw on cloudflare. Place for me to dump thoughts into the void</p>

  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <a href={`/posts/${post.id}/`}>{post.data.title}</a>
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString('en-US', { dateStyle: 'medium', timeZone: 'UTC' })}
        </time>
        <p>{post.data.description}</p>
      </li>
    ))}
  </ul>
</BaseLayout>
